# sockt-runtime (in-pod). Copy to .env or set via RunPod template / docker env.

# Pod identity
SANDBOX_ID=
POD_ID=

# Base URL of the control plane API (this process calls into it)
CONTROL_PLANE_URL=https://api.sockt.dev

# HS256 secret for data_jwt — must match control plane WSS_JWT_SECRET
JWT_SECRET=

# Billing (msats for lightning, cents for credits — matches control-plane semantics)
BILLING_METHOD=lightning
RATE_PER_SECOND=10
INITIAL_BALANCE=100000
TOPUP_THRESHOLD=10000
TOPUP_AMOUNT=50000
SAFETY_FLOOR=0

# Bearer token for runtime → control-plane callback routes — must match control plane CALLBACK_SECRET
CALLBACK_SECRET=

# Network
LISTEN_ADDR=:8443
TLS_CERT_FILE=
TLS_KEY_FILE=

# PTY / exec identity drop
SANDBOX_USER=sandbox
