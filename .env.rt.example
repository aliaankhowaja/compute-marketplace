# sockt-runtime (in-pod). Copy to .env or set via RunPod template / docker env.

# Pod identity
SANDBOX_ID=
POD_ID=

# Base URL of the control plane API (this process calls into it)
CONTROL_PLANE_URL=https://api.sockt.dev

# HS256 secret for data_jwt — must match control plane WSS_JWT_SECRET
JWT_SECRET=
# Must match control plane JWT_AUDIENCE (default sockt-runtime); required claim on data_jwt
JWT_AUDIENCE=sockt-runtime

# Billing (msats for lightning, cents for credits — matches control-plane semantics)
BILLING_METHOD=lightning
RATE_PER_SECOND=10
INITIAL_BALANCE=100000
TOPUP_THRESHOLD=10000
TOPUP_AMOUNT=50000
SAFETY_FLOOR=0

# Bearer token for runtime → control-plane callback routes — must match control plane CALLBACK_SECRET
CALLBACK_SECRET=

# Network
LISTEN_ADDR=:8443
TLS_CERT_FILE=
TLS_KEY_FILE=

# Path jail + default cwd for exec/shell/files (must exist and be writable when not running as root)
SANDBOX_ROOT=/home/sandbox

# PTY / exec identity drop
SANDBOX_USER=sandbox

# Interactive shell (browser clients send Origin; comma-separated allowlist; use * to allow any origin)
SHELL_WS_ALLOWED_ORIGINS=
SHELL_WS_MAX_MSG_BYTES=65536
# 0 = unlimited concurrent shell WebSockets
SHELL_MAX_CONCURRENT=16
