# =============================================================================
# Sockt AgentSDK — reference environment variables
# Copy to `.env` and export (`set -a; source .env; set +a`) before running tests/tools.
# Only fields relevant to your flow need values.
# =============================================================================

# --- Control plane base URL (SDK + MCP proxy) ---
SOCKT_API_URL=https://api.sockt.dev
# Alias supported by MCP proxy / some docs:
SOCKT_API_BASE_URL=https://api.sockt.dev

# Streamable HTTP MCP path on the control plane (POST, JSON-RPC per request)
SOCKT_MCP_PATH=/v1/mcp

# Optional: pin an existing MCP session id (otherwise proxy learns it from `initialize`)
SOCKT_MCP_SESSION_ID=

# --- Authentication (pick ONE primary path for SDK / proxy) ---
# MCP proxy: leave SOCKT_API_KEY empty for anonymous Lightning. The proxy auto-captures the
# `sandbox_token` (sbx_…) returned by `tools/call sandbox_create` and reuses it on later calls.
# API key (credits sandboxes; prefix usually `sockt_live_`)
SOCKT_API_KEY=

# Supabase / dashboard JWT for /v1/user/* endpoints (profile, credits, API key management)
SOCKT_USER_JWT=
SOCKT_SUPABASE_JWT=

# Optional: explicit sandbox bearer for SDK use (`sbx_…`); MCP proxy captures this automatically.
SOCKT_SANDBOX_TOKEN=

# --- Optional: explicit auth mode hint for local tooling/docs ---
SOCKT_AUTH_MODE=api_key
# Allowed values: api_key | jwt | sandbox_token

# --- Data JWT refresh behaviour (SDK) ---
# Refresh when remaining validity drops below this many seconds (default 600)
SOCKT_DATA_JWT_REFRESH_THRESHOLD_SECS=600
# Alias naming from backend-ish terminology:
SOCKT_DATA_JWT_REFRESH_SKEW_SECS=60
SOCKT_DATA_JWT_MIN_VALIDITY_SECS=120

# Backoff when runtime signals pod cold start / transient placement (seconds)
SOCKT_POD_STARTING_BACKOFF_SECS=2

# --- HTTP client timeouts ---
SOCKT_HTTP_TIMEOUT_MS=120000
SOCKT_HTTP_TIMEOUT_SECS=120

# Retry knobs for SDK wrappers / future transports
SOCKT_RETRY_MAX_ATTEMPTS=2
SOCKT_RETRY_BASE_DELAY_MS=250

# --- Sandbox creation defaults (optional helpers / samples) ---
SOCKT_DEFAULT_BILLING_METHOD=credits
SOCKT_DEFAULT_TIER=nano
SOCKT_DEFAULT_RUNTIME=runpod_cpu

# Control plane sets RunPod pods from tier (nano|micro|standard|gpu_small|gpu_large).
# If you script RunPod REST yourself outside this SDK, set template ids on the runner (informational):
SOCKT_TEMPLATE_RUNPOD_CPU=
SOCKT_TEMPLATE_RUNPOD_GPU=

# Region hint if you script RunPod directly (informational)
SOCKT_DEFAULT_REGION=US-CA-1

# --- Legacy placeholders (unused in sandbox-scoped prepaid BOLT11 MVP; safe to omit) ---
SOCKT_LEXE_ENV=mainnet
SOCKT_LEXE_SEED_PATH=
SOCKT_BOLT12_OFFER=
SOCKT_LIGHTNING_ADDRESS=

# --- Logging ---
LOG_LEVEL=info
SOCKT_LOG_LEVEL=info

# --- Integration tests against REAL APIs (off by default) ---
SOCKT_RUN_LIVE_TESTS=0
SOCKT_LIVE_API_URL=
SOCKT_LIVE_API_KEY=

# =============================================================================
# Control-plane / runtime secrets (NOT used directly by AgentSDK packages,
# but listed here so AgentSDK `.env` can mirror a full dev deployment folder)
# =============================================================================

SANDBOX_ID=
POD_ID=
CONTROL_PLANE_URL=https://api.sockt.dev

JWT_SECRET=
WSS_JWT_SECRET=

BILLING_METHOD=lightning
RATE_PER_SECOND=10
INITIAL_BALANCE=100000
TOPUP_THRESHOLD=10000
TOPUP_AMOUNT=50000
SAFETY_FLOOR=0

CALLBACK_SECRET=

LISTEN_ADDR=:8443
TLS_CERT_FILE=
TLS_KEY_FILE=
SANDBOX_USER=sandbox

PORT=8080
LISTEN_HTTP=0.0.0.0:8080

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_TX_DSN=
SUPABASE_DB_SESSION_DSN=

RUNPOD_API_KEY=
RUNPOD_API_URL=https://rest.runpod.io/v1
RUNPOD_DEFAULT_REGION=US-CA-1

LND_GRPC_HOST=
LND_TLS_CERT_PATH=
LND_TLS_CERT_PEM=
LND_MACAROON_PATH=
LND_MACAROON_HEX=
LND_NETWORK=mainnet

# Unused if LNDK / LNURL pull-pay integrations are disabled (prepaid deposits only).
LNDK_HTTP_URL=
LNURL_HTTP_TIMEOUT_SECS=8

DATA_JWT_TTL_SECS=3600

BALANCE_LOW_WATER_SECS=60
BALANCE_TOPUP_CHUNK_SECS=300
LOW_CREDIT_THRESHOLD_CENTS=100

# Sandbox-scoped prepay (lightning): seconds of compute funded per BOLT11 invoice and the
# remaining-seconds threshold below which the runtime requests a top-up.
SANDBOX_PREPAY_SECS=30
SANDBOX_TOPUP_TRIGGER_SECS=5

API_KEY_CACHE_SIZE=10000

# Combined per-IP / per-principal rate limit on POST /v1/mcp.
MCP_RPM=120

STRIPE_WEBHOOK_SECRET=

ENV=dev
ADMIN_RECONCILE_TOKEN=

DB_MAX_CONNS=
DB_MIN_CONNS=
DB_MAX_CONN_LIFETIME_SECS=
DB_MAX_CONN_IDLE_SECS=
