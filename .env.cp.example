# sockt-cp (control plane). Copy to .env for local runs or inject in Cloud Run / your host.

# HTTP
PORT=8080
LISTEN_HTTP=0.0.0.0:8080
LOG_LEVEL=info
ENV=dev

# Public URL of this service (e.g. https://api.sockt.dev) — passed to RunPod pods / templates
CONTROL_PLANE_URL=https://api.sockt.dev

# Supabase / Postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_TX_DSN=
SUPABASE_DB_SESSION_DSN=

# RunPod
RUNPOD_API_KEY=
RUNPOD_API_URL=https://rest.runpod.io/v1
RUNPOD_DEFAULT_REGION=US-CA-1

# LND
LND_GRPC_HOST=10.0.0.14:10009
LND_TLS_CERT_PATH=/run/secrets/lnd-tls.pem
LND_TLS_CERT_PEM=
LND_MACAROON_PATH=/run/secrets/lnd.macaroon
LND_MACAROON_HEX=
LND_NETWORK=mainnet

# Lightning autonomy
LNDK_HTTP_URL=
LNURL_HTTP_TIMEOUT_SECS=8

# Auth — WSS_JWT_SECRET must match sockt-runtime JWT_SECRET; L402_ROOT_KEY is 64 hex chars (32 bytes) if set
WSS_JWT_SECRET=
L402_ROOT_KEY=
DATA_JWT_TTL_SECS=3600

# Runtime callbacks — must match CALLBACK_SECRET on each pod
CALLBACK_SECRET=

# Billing defaults
BALANCE_LOW_WATER_SECS=60
BALANCE_TOPUP_CHUNK_SECS=300
LOW_CREDIT_THRESHOLD_CENTS=100
INVOICE_POOL_TARGET=100
INVOICE_POOL_REFILL_BELOW=40

# API key cache
API_KEY_CACHE_SIZE=10000

# Postgres pool (optional tuning)
DB_MAX_CONNS=15
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_SECS=1800
DB_MAX_CONN_IDLE_SECS=300

# MCP (Streamable HTTP JSON-RPC at POST /v1/mcp)
MCP_PROXY_TIMEOUT_SECS=120
MCP_REQUEST_BODY_LIMIT_BYTES=4194304
MCP_DATA_JWT_TTL_SECS=300

# Stripe
STRIPE_WEBHOOK_SECRET=

# Admin (optional Bearer for POST /admin/reconcile)
ADMIN_RECONCILE_TOKEN=
