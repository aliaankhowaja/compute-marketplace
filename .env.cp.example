# sockt-cp (control plane). Copy to .env for local runs or inject in Cloud Run / your host.

# HTTP
PORT=8080
LISTEN_HTTP=0.0.0.0:8080
LOG_LEVEL=info
ENV=dev

# Public URL of this service (e.g. https://api.sockt.dev) — passed to RunPod pods / templates
CONTROL_PLANE_URL=https://api.sockt.dev

# Supabase / Postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_TX_DSN=
SUPABASE_DB_SESSION_DSN=

# RunPod
RUNPOD_API_KEY=
RUNPOD_API_URL=https://rest.runpod.io/v1
RUNPOD_DEFAULT_REGION=US-CA-1
# Per-tier template IDs (each points to the tier-specific Docker image).
# CPU tiers fall back to RUNPOD_TEMPLATE_CPU_ID if their specific ID is unset.
RUNPOD_TEMPLATE_CPU_ID=
RUNPOD_TEMPLATE_NANO_ID=
RUNPOD_TEMPLATE_MICRO_ID=
RUNPOD_TEMPLATE_STANDARD_ID=
RUNPOD_TEMPLATE_GPU_SMALL_ID=
RUNPOD_TEMPLATE_GPU_LARGE_ID=

# LNBOT (https://ln.bot/docs/api) — wallet key recommended (wk_…); treasury wallet at Sockt
LNBOT_API_BASE_URL=https://api.ln.bot
LNBOT_API_KEY=
# Optional wal_…; omit with wk_ to use /v1/wallets/current
LNBOT_WALLET_ID=
LNBOT_HTTP_TIMEOUT_SECS=45
# mainnet | testnet — BOLT11 decode only (no node RPC)
LIGHTNING_NETWORK=mainnet

# LNURL client timeouts (unused unless LNURL integrations enabled)
LNURL_HTTP_TIMEOUT_SECS=8

# Auth — WSS_JWT_SECRET must match sockt-runtime JWT_SECRET
WSS_JWT_SECRET=
# aud claim on minted data_jwt; must match JWT_AUDIENCE on each pod (default sockt-runtime)
JWT_AUDIENCE=sockt-runtime
# default SANDBOX_ROOT passed to new pods (override per deployment)
RUNTIME_SANDBOX_ROOT=/home/sandbox
DATA_JWT_TTL_SECS=3600

# Runtime callbacks — must match CALLBACK_SECRET on each pod
CALLBACK_SECRET=

# Billing defaults
BALANCE_LOW_WATER_SECS=60
BALANCE_TOPUP_CHUNK_SECS=300
LOW_CREDIT_THRESHOLD_CENTS=100

# Sandbox-scoped Lightning prepay defaults.
# SANDBOX_PREPAY_SECS: seconds of compute funded per BOLT11 invoice (initial + each top-up chunk).
# SANDBOX_TOPUP_TRIGGER_SECS: seconds-remaining threshold below which the runtime asks for the next chunk.
SANDBOX_PREPAY_SECS=30
SANDBOX_TOPUP_TRIGGER_SECS=5

# API key cache
API_KEY_CACHE_SIZE=10000

# Postgres pool (optional tuning)
DB_MAX_CONNS=15
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_SECS=1800
DB_MAX_CONN_IDLE_SECS=300

# MCP (Streamable HTTP JSON-RPC at POST /v1/mcp)
MCP_PROXY_TIMEOUT_SECS=120
MCP_REQUEST_BODY_LIMIT_BYTES=4194304
MCP_DATA_JWT_TTL_SECS=300
# Combined per-IP / per-principal rate limit for POST /v1/mcp.
MCP_RPM=120

# Stripe
STRIPE_WEBHOOK_SECRET=

# Admin (optional Bearer for POST /admin/reconcile)
ADMIN_RECONCILE_TOKEN=
