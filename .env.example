# Pod identity (set via RunPod template / docker env)
SANDBOX_ID=
POD_ID=
CONTROL_PLANE_URL=https://api.sockt.dev

# JWT (HS256 secret shared with control plane for data_jwt)
JWT_SECRET=

# Billing (units are msats for lightning, cents for credits — matches control-plane semantics)
BILLING_METHOD=lightning
RATE_PER_SECOND=10
INITIAL_BALANCE=100000
TOPUP_THRESHOLD=10000
TOPUP_AMOUNT=50000
SAFETY_FLOOR=0

# Callback auth (Bearer token runtime sends to control-plane callback routes)
CALLBACK_SECRET=

# Network
LISTEN_ADDR=:8443
TLS_CERT_FILE=
TLS_KEY_FILE=

# PTY / exec identity drop
SANDBOX_USER=sandbox

# === control plane (sockt-cp) ===
PORT=8080
LISTEN_HTTP=0.0.0.0:8080
CONTROL_PLANE_URL=https://api.sockt.dev

# Supabase / Postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_TX_DSN=
SUPABASE_DB_SESSION_DSN=

# RunPod
RUNPOD_API_KEY=
RUNPOD_API_URL=https://rest.runpod.io/v1
RUNPOD_DEFAULT_REGION=US-CA-1

# LND
LND_GRPC_HOST=10.0.0.14:10009
LND_TLS_CERT_PATH=/run/secrets/lnd-tls.pem
LND_MACAROON_PATH=/run/secrets/lnd.macaroon
LND_NETWORK=mainnet

# Lightning autonomy
LNDK_HTTP_URL=
LNURL_HTTP_TIMEOUT_SECS=8

# Auth (WSS_JWT_SECRET shared with sockt-runtime as JWT_SECRET)
WSS_JWT_SECRET=
L402_ROOT_KEY=
DATA_JWT_TTL_SECS=3600

# Runtime callbacks (same value as pod CALLBACK_SECRET)
CALLBACK_SECRET=

# Billing defaults
BALANCE_LOW_WATER_SECS=60
BALANCE_TOPUP_CHUNK_SECS=300
LOW_CREDIT_THRESHOLD_CENTS=100
INVOICE_POOL_TARGET=100
INVOICE_POOL_REFILL_BELOW=40

# API key cache
API_KEY_CACHE_SIZE=10000

# Stripe
STRIPE_WEBHOOK_SECRET=

# Misc
LOG_LEVEL=info
ENV=dev
ADMIN_RECONCILE_TOKEN=
