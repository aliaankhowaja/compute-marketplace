# Pod identity (set via RunPod template / docker env)
SANDBOX_ID=
POD_ID=
CONTROL_PLANE_URL=https://api.sockt.dev

# JWT (HS256 secret shared with control plane for data_jwt)
JWT_SECRET=

# Billing (units are msats for lightning, cents for credits — matches control-plane semantics)
BILLING_METHOD=lightning
RATE_PER_SECOND=10
INITIAL_BALANCE=100000
TOPUP_THRESHOLD=10000
TOPUP_AMOUNT=50000
SAFETY_FLOOR=0

# Callback auth (Bearer token runtime sends to control-plane callback routes)
CALLBACK_SECRET=

# Network
LISTEN_ADDR=:8443
TLS_CERT_FILE=
TLS_KEY_FILE=

# PTY / exec identity drop
SANDBOX_USER=sandbox
