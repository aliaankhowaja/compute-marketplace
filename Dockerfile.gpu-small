FROM golang:1.26-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY internal ./internal
COPY cmd ./cmd
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags="-s -w" -mod=vendor -o /sockt-runtime ./cmd/sockt-runtime

FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04 AS python-builder
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
     python3 python3-pip python3-venv python3-dev \
     build-essential libffi-dev libssl-dev \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/ml \
  && /opt/ml/bin/pip install --no-cache-dir --no-compile \
     --index-url https://download.pytorch.org/whl/cu126 \
     torch torchvision \
  && /opt/ml/bin/pip install --no-cache-dir --no-compile \
     transformers accelerate \
     numpy scipy pillow \
     sentencepiece tokenizers safetensors \
     huggingface-hub

RUN find /opt/ml -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null; \
    find /opt/ml -type d -name "tests" -exec rm -rf {} + 2>/dev/null; \
    find /opt/ml -type d -name "test" -exec rm -rf {} + 2>/dev/null; \
    find /opt/ml -type f -name "*.pyc" -delete 2>/dev/null; \
    find /opt/ml -path "*/torch/test/*" -delete 2>/dev/null; \
    find /opt/ml -path "*/caffe2/python/test/*" -delete 2>/dev/null; \
    true

FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04 AS runtime
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
     bash ca-certificates curl wget jq sudo \
     python3 python3-pip python3-venv python3-dev \
     git openssh-client \
     build-essential libffi-dev libssl-dev \
  && rm -rf /var/lib/apt/lists/*

COPY --from=python-builder /opt/ml /opt/ml

RUN useradd -m -u 1001 -s /bin/bash sandbox

COPY sudoers-sandbox /etc/sudoers.d/sandbox
RUN chmod 0440 /etc/sudoers.d/sandbox \
  && chown root:root /etc/sudoers.d/sandbox \
  && visudo -c

COPY --from=build /sockt-runtime /usr/local/bin/sockt-runtime
RUN chmod 755 /usr/local/bin/sockt-runtime \
  && mkdir -p /home/sandbox \
  && chown sandbox:sandbox /home/sandbox \
  && chown -R sandbox:sandbox /opt/ml

ENV PATH="/opt/ml/bin:$PATH"

EXPOSE 8443
WORKDIR /home/sandbox
ENTRYPOINT ["/usr/local/bin/sockt-runtime"]
