FROM golang:1.26-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY internal ./internal
COPY cmd ./cmd
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags="-s -w" -mod=vendor -o /sockt-runtime ./cmd/sockt-runtime

FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04 AS runtime
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
     bash ca-certificates curl wget jq sudo \
     python3 python3-pip python3-venv python3-dev \
     git openssh-client \
     build-essential libffi-dev libssl-dev \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/ml \
  && /opt/ml/bin/pip install --no-cache-dir \
     torch torchvision torchaudio \
     transformers accelerate \
     numpy scipy pillow \
     sentencepiece tokenizers safetensors \
     huggingface-hub

RUN useradd -m -u 1001 -s /bin/bash sandbox

COPY sudoers-sandbox /etc/sudoers.d/sandbox
RUN chmod 0440 /etc/sudoers.d/sandbox \
  && chown root:root /etc/sudoers.d/sandbox \
  && visudo -c

COPY --from=build /sockt-runtime /usr/local/bin/sockt-runtime
RUN chmod 755 /usr/local/bin/sockt-runtime \
  && mkdir -p /home/sandbox \
  && chown sandbox:sandbox /home/sandbox \
  && chown -R sandbox:sandbox /opt/ml

ENV PATH="/opt/ml/bin:$PATH"

EXPOSE 8443
WORKDIR /home/sandbox
ENTRYPOINT ["/usr/local/bin/sockt-runtime"]
